{
    "version": 6,
    "configurePresets": [
        {
            "name": "user-env",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_PREFIX_PATH": "${sourceDir}/../tools/rexglue/win-amd64"
            }
        },
        {
            "name": "user-env-linux",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_PREFIX_PATH": "${sourceDir}/../tools/rexglue/linux-amd64"
            }
        },
        { "name": "sptd-debug",          "inherits": ["win-amd64-debug",          "user-env"] },
        { "name": "sptd-release",        "inherits": ["win-amd64-release",        "user-env"] },
        { "name": "sptd-relwithdebinfo", "inherits": ["win-amd64-relwithdebinfo", "user-env"] },
        { "name": "sptd-linux-release",  "inherits": ["linux-amd64-release",      "user-env-linux"] },
        { "name": "sptd-dev",            "inherits": ["sptd-relwithdebinfo"], "cacheVariables": { "SPTD_DEV_TOOLS": "ON" } }
    ],
    "buildPresets": [
        { "name": "sptd-debug",          "configurePreset": "sptd-debug" },
        { "name": "sptd-release",        "configurePreset": "sptd-release" },
        { "name": "sptd-relwithdebinfo", "configurePreset": "sptd-relwithdebinfo" },
        { "name": "sptd-linux-release",  "configurePreset": "sptd-linux-release" },
        { "name": "sptd-dev",            "configurePreset": "sptd-dev" }
    ]
}
